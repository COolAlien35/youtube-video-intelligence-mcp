# ── YouTube Video Intelligence MCP — environment variables ───────────────────
#
# Copy this file to .env for local development.
# Real secrets live in Render environment variables or GitHub Secrets — NEVER in git.
#
# Phase 2: no live YouTube API keys or OAuth secrets yet (live_youtube_enabled=false).
# All variables below use the YT_INTEL_ prefix.

YT_INTEL_ENVIRONMENT=dev
YT_INTEL_HOST=127.0.0.1
YT_INTEL_PORT=8000
YT_INTEL_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
YT_INTEL_LOG_LEVEL=INFO
YT_INTEL_DATA_DIR=./var
# Optional override; derived from YT_INTEL_DATA_DIR/yt_intel.db when empty
YT_INTEL_DATABASE_URL=
# Optional path to synthetic fixtures directory
YT_INTEL_FIXTURES_DIR=
YT_INTEL_QUOTA_COMMON_DAILY_CAP=2000
YT_INTEL_QUOTA_SEARCH_DAILY_CAP=20
YT_INTEL_MAX_CONCURRENT_WORKFLOWS_PER_PRINCIPAL=2
YT_INTEL_MAX_WORKFLOW_STARTS_PER_MINUTE=5
# Fail-closed policy flag (must remain false in Phase 2)
YT_INTEL_LIVE_YOUTUBE_ENABLED=false
