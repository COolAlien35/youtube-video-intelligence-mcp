# ── YouTube Video Intelligence MCP — environment variables ───────────────────
#
# Copy this file to .env and fill in the values.
# Real values live in Render environment variables or GitHub Secrets — NEVER in git.
#
# Phase 1: no API keys are created and the YouTube Data API is NOT enabled.
# These placeholders document the variables that later phases will require.

# YouTube Data API v3 key (Phase 3+)
YOUTUBE_API_KEY=

# Supabase (Phase 4+)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
DATABASE_URL=
SECRET_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO
